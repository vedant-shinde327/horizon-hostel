<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Horizon Hostel</title>

  <link rel="stylesheet" href="/css/global.css" />

  <link rel="stylesheet" href="/css/navbar.css" />

  <link rel="stylesheet" href="/css/footer.css" />

  <link rel="stylesheet" href="/css/home.css" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Overpass:ital,wght@0,100..900;1,100..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet">

</head>

<body>
  <%- include("partials/navbar") %>

    <main>
      <section class="hero">
        <div class="hero-container">
          <!-- left content -->
          <div class="hero-content">
            <h1>Smart Student Living For Modern Campus Life</h1>

            <p>
              Experience comfortable hostel living with smart management,
              healthy meals, secure environment, and productivity-focused
              spaces.
            </p>

            <div class="hero-btns">
              <button class="primary-btn">Explore hostel</button>
              <button class="secondary-btn">View Facilities</button>
            </div>
          </div>

          <!-- right image -->
          <div class="hero-img">
            <img src="/assets/images/home page.png" alt="rero_img" />
          </div>
        </div>
      </section>

      <!-- stats section -->

      <section class="stat-section">
        <div class="stats">
          <div class="stats-container">
            <div class="stat-card">
              <h2>500+</h2>
              <p>Students</p>
            </div>

            <div class="stat-card">
              <h2>140</h2>
              <p>Rooms</p>
            </div>

            <div class="stat-card">
              <h2>24/7</h2>
              <p>Security</p>
            </div>

            <div class="stat-card">
              <h2>3</h2>
              <p>Daily Meals</p>
            </div>
          </div>
        </div>
      </section>

      <!-- About section -->
      <section class="About-section">
        <div class="about">
          <div class="about-container">
            <!-- left area -->
            <div class="about-images">
              <img class="about-img-1" src="/assets/images/recreation room.png" alt="recreatio-room" />

              <img class="about-img-2" src="/assets/images/receptionn  room.png" alt="reception-area" />
            </div>

            <!-- right content -->

            <div class="about-content">
              <span class="section-tag"> About Hostel </span>

              <h2>Designed For Comfortable And Productive Student Living</h2>

              <p>
                Horizon Hostel provides modern student accommodation with secure
                living spaces, healthy food services, high-speed internet, and
                productivity-focused environments for academic success.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- FACILITIES SECTION -->
      <section class="facility">
        <h1>Hostel Facilities</h1>

        <div class="facilities">
          <div class="facilities-container">

            <div class="facility-card">
              <i class="fa-solid fa-wifi"></i>
              <h3>WiFi Access</h3>
              <p>Reliable internet for study, coding, and entertainment.</p>
            </div>

            <div class="facility-card">
              <i class="fa-solid fa-book-open"></i>
              <h3>Study Lounge</h3>
              <p>Quiet and comfortable study spaces for focused learning.</p>
            </div>

            <div class="facility-card">
              <i class="fa-solid fa-utensils"></i>
              <h3>Healthy Meals</h3>
              <p>Nutritious and hygienic food prepared daily.</p>
            </div>

            <div class="facility-card">
              <i class="fa-solid fa-shield-halved"></i>
              <h3>CCTV Security</h3>
              <p>Secure campus monitoring with controlled hostel access.</p>
            </div>

            <div class="facility-card">
              <i class="fa-solid fa-shirt"></i>
              <h3>Laundry Service</h3>
              <p>Convenient laundry facilities available for students.</p>
            </div>

            <div class="facility-card">
              <i class="fa-solid fa-gamepad"></i>
              <h3>Recreation Area</h3>
              <p>
                Indoor activity spaces for relaxation and social interaction.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="gallery">

        <div class="section-header">

          <span class="section-tag">
            GALLERY
          </span>

          <h2>
            Explore Our Hostel Spaces
          </h2>

          <p>
            A modern environment designed for
            comfortable and productive student living.
          </p>

        </div>

        <div class="gallery-grid">

          <div class="gallery-item large">

            <img src="/assets/gallery/exterior image.png" alt="Hostel Exterior">

          </div>

          <div class="gallery-item">

            <img src="/assets/gallery/study lounge.png" alt="Study Lounge">

          </div>

          <div class="gallery-item">

            <img src="/assets/gallery/modern room.png" alt="Modern Room">

          </div>

          <div class="gallery-item">

            <img src="/assets/gallery/mess.png" alt="Mess Area">

          </div>

          <div class="gallery-item wide">

            <img src="/assets/gallery/recreation.png" alt="Recreation Area">

          </div>

          <div class="gallery-item">

            <img src="/assets/gallery/laundry.png" alt="Laundry Area">
          </div>

        </div>
      </section>

      <!-- CTA section -->
      <section class="cta">

        <div class="cta-container">

          <!-- LEFT -->
          <div class="cta-content">

            <span class="section-tag light-tag">
              JOIN HORIZON HOSTEL
            </span>

            <h2>
              Ready To Experience
              Modern Student Living?
            </h2>

            <p>
              Comfortable rooms, secure environment,
              productive study spaces, and a vibrant
              student community — all in one place.
            </p>

          </div>

          <!-- RIGHT -->
          <div class="cta-actions">

            <a href="/register">
              <button class="cta-primary-btn">
                Apply Now
              </button>
            </a>

            <button class="cta-secondary-btn">
              Contact Us
            </button>
          </div>
        </div>
      </section>
    </main>

    <%- include("partials/footer") %>

</body>

</html>